CREATE DATABASE NYKAA

USE NYKAA

SELECT * FROM NYKAA_DATASET

BEGIN TRANSACTION;

-- DATA CLEANING

SELECT
	COUNT(CASE WHEN Campaign_ID IS NULL THEN 1 END) AS Campaign_id,
	COUNT(CASE WHEN Campaign_Type IS NULL THEN 1 END) AS Campaign_Type,
	COUNT(CASE WHEN Target_Audience IS NULL THEN 1 END) AS Target_Audience,
	COUNT(CASE WHEN Duration IS NULL THEN 1 END) AS Duration,
	COUNT(CASE WHEN Channel_Used IS NULL THEN 1 END) AS Channel_Used,
	COUNT(CASE WHEN Impressions IS NULL THEN 1 END) AS Impressions,
	COUNT(CASE WHEN Clicks IS NULL THEN 1 END) AS Clicks,
	COUNT(CASE WHEN Leads IS NULL THEN 1 END) AS Leads,
	COUNT(CASE WHEN Conversions IS NULL THEN 1 END) AS Conversions,
	COUNT(CASE WHEN Revenue IS NULL THEN 1 END) AS Revenue,
	COUNT(CASE WHEN Acquisition_Cost IS NULL THEN 1 END) AS Acquisition_Cost,
	COUNT(CASE WHEN ROI IS NULL THEN 1 END) AS ROI,
	COUNT(CASE WHEN Language IS NULL THEN 1 END) AS Language,
	COUNT(CASE WHEN Engagement_Score IS NULL THEN 1 END) AS Engagement_Score,
	COUNT(CASE WHEN Customer_Segment IS NULL THEN 1 END) AS Customer_Segment,
	COUNT(CASE WHEN Date IS NULL THEN 1 END) AS Date
FROM NYKAA_DATASET;

-- DUPLICATES CAMPAIGN_ID 

SELECT
	Campaign_ID,
	COUNT(DISTINCT Campaign_ID) Total
FROM NYKAA_DATASET
GROUP BY Campaign_ID
HAVING COUNT(DISTINCT Campaign_ID)>1


-- CONVERTING REVENUE INT TO BIG INT
ALTER TABLE NYKAA_DATASET
ALTER COLUMN Revenue BIGINT;



-- UPDATE AVERAGE IN ACQUISITION COST
SELECT
AVG(Acquisition_Cost) AS AVGERAGE
FROM NYKAA_DATASET

UPDATE 
NYKAA_DATASET 
